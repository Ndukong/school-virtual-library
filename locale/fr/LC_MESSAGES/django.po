# --- Python gettext (views / services / prompts) ----------------------------
msgid "Too many failed attempts. Try again in %(seconds)d second(s)."
msgstr "Trop de tentatives échouées. Réessayez dans %(seconds)d seconde(s)."

msgid "Signed out %(count)d other session(s)."
msgstr "%(count)d autre(s) session(s) terminée(s)."

msgid "Book not found in your library."
msgstr "Livre introuvable dans votre bibliothèque."

msgid "Chapter not found in your library."
msgstr "Chapitre introuvable dans votre bibliothèque."

msgid "Questions are limited to %(maximum)d characters (you sent %(sent)d)."
msgstr "Les questions sont limitées à %(maximum)d caractères (vous en avez envoyé %(sent)d)."

msgid "I could not find any relevant material in the selected scope. Try widening the scope, using different wording, or checking that the material has finished processing. I will not guess at content that is not in the library."
msgstr "Je n'ai trouvé aucun support pertinent dans la sélection. Élargissez la sélection, reformulez votre question, ou vérifiez que le document a fini d'être traité. Je ne devine jamais un contenu qui n'est pas dans la bibliothèque."

msgid "The AI service is temporarily unavailable. Please try again shortly."
msgstr "Le service d'IA est temporairement indisponible. Veuillez réessayer dans quelques instants."

msgid "No relevant material was found for this %(kind)s in the selected scope. Widen the scope or choose material that has finished processing."
msgstr "Aucun support pertinent n'a été trouvé pour ce %(kind)s dans la sélection. Élargissez la sélection ou choisissez du matériel qui a fini d'être traité."

msgid "Unknown study material kind: %(kind)s"
msgstr "Type de support d'étude inconnu : %(kind)s"

msgid "Summary"
msgstr "Résumé"

msgid "Revision notes"
msgstr "Fiches de révision"

msgid "Definitions and formulae"
msgstr "Définitions et formules"

msgid "Practice questions"
msgstr "Questions d'entraînement"

msgid "Respond in French. Keep passages quoted from the sources verbatim - never translate quoted text, titles, or citations."
msgstr "Répondez en français. Conservez les passages cités des sources mot pour mot - ne traduisez jamais le texte cité, les titres ou les citations."

msgid "Respond in English. Keep passages quoted from the sources verbatim - never translate quoted text, titles, or citations."
msgstr "Répondez en anglais. Conservez les passages cités des sources mot pour mot - ne traduisez jamais le texte cité, les titres ou les citations."

