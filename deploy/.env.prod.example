# Production settings template for the docker stack. Copy to .env.prod,
# generate a random SECRET_KEY (python -c "import secrets; print(secrets.token_urlsafe(50))"),
# and set the LAN domain. Never commit .env.prod.
#
# DEBUG stays False; the app refuses to boot with the dev SECRET_KEY or an
# empty ALLOWED_HOSTS in that mode (config.settings validate_run_mode).

# --- Caddy / TLS ---
DOMAIN=library.local

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=library.local,localhost
CSRF_TRUSTED_ORIGINS=https://library.local

# --- Database (consumed by docker-compose.prod.yml, not by Django) ---
POSTGRES_DB=svl
POSTGRES_USER=svl
POSTGRES_PASSWORD=change-me-strong-db-password

# --- AI provider (never leave unset in production) ---
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_BASE_URL=https://your-nim-router.example.org/v1
AI_EMBEDDING_MODEL=mock-embed-small
AI_CHAT_PROVIDER=openai_compatible
AI_CHAT_MODEL=

# --- WhatsApp (set the Meta app secret so the webhook fails closed) ---
WHATSAPP_PROVIDER=console
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Search / embeddings (PostgreSQL lives in the stack) ---
SEARCH_PGVECTOR_DIM=768

# --- Retention (0 = off) ---
AI_RETENTION_DAYS=0

# --- Budgets (0 = unlimited) ---
AI_BUDGET_DAILY_REQUESTS=0
AI_BUDGET_MONTHLY_REQUESTS=0
AI_BUDGET_DAILY_TOKENS=0
AI_BUDGET_MONTHLY_TOKENS=0