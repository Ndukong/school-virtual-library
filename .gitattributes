# Normalize line endings across editors and agents.
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.cfg  text eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary artifacts.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
db.sqlite3 binary
