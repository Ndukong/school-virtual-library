# Copy this file to .env and fill in real values.
# Never commit .env.

# Core Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Production security (default on when DEBUG=False; all env-overridable).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://library.example.org
# SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# Windows/CI note: to run `manage.py check --deploy` you must supply this
# process environment (env beats .env):
#   DEBUG=False SECRET_KEY=<long random> ALLOWED_HOSTS=library.example.org

# Database connection pooling / sslmode come from DATABASE_URL
# (e.g. ...?sslmode=require). Connection age in seconds:
# DATABASE_CONN_MAX_AGE=60

# Cache / rate limiting
# REDIS_URL=redis://localhost:6379/0
# AI_RATE_LIMIT_USE_CACHE=True
# AI_RATE_LIMIT_EXEMPT_SUPERUSER=False
# AI_RATE_LIMIT_PER_MINUTE=10

# Semantic search ranking (WP5): pgvector dimension for the PostgreSQL path.
# 0 keeps the SQLite/Python fallback. Apply `search` migration + run
# `python manage.py backfill_pg_vectors` once on PostgreSQL.
# SEARCH_PGVECTOR_DIM=768

# Sessions (shared lab machines assumed)
# SESSION_COOKIE_AGE=7200
# SESSION_IDLE_SECONDS=1800

# Login lockout (WP3): exponential backoff keyed on username + IP.
# LOGIN_LOCKOUT_BASE_SECONDS=5
# LOGIN_LOCKOUT_MAX_SECONDS=300

# Library download abuse control (WP3)
# LIBRARY_DOWNLOAD_PER_MINUTE=10
# LIBRARY_DOWNLOAD_DAILY_CAP=50
# Reverse-proxy internal file serving instead of app streaming:
# LIBRARY_XACCEL_ENABLED=False
# LIBRARY_INTERNAL_PATH_PREFIX=/internal

# Database. Uncomment to use PostgreSQL (requires a running server).
# In Phase 0-3 local development defaults to SQLite; no DATABASE_URL needed.
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/school_library

# --- Document processing (Phase 3 + WP4 OCR). ---
# OCR: real engine needs Tesseract + Ghostscript binaries on PATH for
# ocrmypdf. Without them, blank pages are flagged needs_ocr and marked for
# teacher review instead of the resource failing. FAKE_* are test-only.
# DOCUMENTS_OCR_TIMEOUT_SECONDS=300
# DOCUMENTS_OCR_MAX_PAGES=500
# DOCUMENTS_OCR_LANGUAGES=eng,fra
# DOCUMENTS_OCR_FAKE_ENGINE=False
# DOCUMENTS_OCR_FAKE_CONFIDENCE=0.9
# DOCUMENTS_OCR_FAKE_EMPTY=False
# DOCUMENTS_OCR_FAKE_SLEEP=0

# Per-school AI budgets (WP5), counted on AIRequestLog. 0 = unlimited.
# AI_BUDGET_DAILY_REQUESTS=0
# AI_BUDGET_MONTHLY_REQUESTS=0
# AI_BUDGET_DAILY_TOKENS=0
# AI_BUDGET_MONTHLY_TOKENS=0
# Per-resource chunk index cap and per-school storage quota:
# DOCUMENTS_MAX_CHUNKS=1000
# SCHOOL_STORAGE_QUOTA_MB=5000
# Local offline embeddings recommend: AI_PROVIDER=local (fastembed,
# multilingual-e5-small). Remote still selectable.
# RAG answer + query-embedding caches:
# RAG_USE_CACHE=True
# RAG_CACHE_TTL=86400
# AI_EMBEDDING_QUERY_CACHE_TTL=86400

# --- AI provider configuration (Phase 4+). ---
# Embeddings (AI_PROVIDER):
#   mock                -> offline deterministic vectors (tests/dev)
#   openai_compatible   -> NVIDIA NIM / routers / vLLM; set AI_BASE_URL
#                          e.g. https://integrate.api.nvidia.com/v1
#   gemini              -> Google Generative Language API
# Note: Groq has NO embeddings endpoint.
# AI_PROVIDER=mock
# AI_API_KEY=
# AI_BASE_URL=
# AI_EMBEDDING_MODEL=mock-embed-small

# Chat generation (Phase 5 AI Librarian). Default: groq.
# Backups: gemini, openai_compatible (NIM), mock (offline tests).
# Per-provider default models apply unless AI_CHAT_MODEL is set.
# AI_CHAT_PROVIDER=groq
# AI_CHAT_MODEL=
# Examples:
#   groq  -> llama-3.3-70b-versatile (default)
#   gemini -> gemini-2.0-flash (default)

# Background jobs (Phases 3+)
# REDIS_URL=redis://localhost:6379/0

# Object storage (Phases 2+)
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# WhatsApp (Phase 10)
#   WHATSAPP_PROVIDER=console  -> logs outbound messages (dev/tests, no network)
#   WHATSAPP_PROVIDER=meta     -> Meta WhatsApp Cloud API (set remaining keys)
# Verify token must match the one configured in the Meta webhook dashboard.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=          # required for webhook signature verification
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_RATE_LIMIT_PER_MINUTE=10
# WHATSAPP_LINK_CODE_MINUTES=15