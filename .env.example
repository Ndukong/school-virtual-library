# Copy this file to .env and fill in real values.
# Never commit .env.

# Core Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Uncomment to use PostgreSQL (requires a running server).
# In Phase 0-3 local development defaults to SQLite; no DATABASE_URL needed.
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/school_library

# --- Reserved for later phases (not used yet) ---
# AI provider configuration (Phase 4+).
#   AI_PROVIDER=mock                -> offline deterministic vectors (tests/dev)
#   AI_PROVIDER=openai_compatible   -> NVIDIA NIM, routers, vLLM, OpenAI-style APIs
#                                      set AI_BASE_URL e.g. https://integrate.api.nvidia.com/v1
#   AI_PROVIDER=gemini              -> Google Generative Language API (embeddings supported)
# Note: Groq has NO embeddings endpoint; use it as a chat provider from Phase 5.
# AI_PROVIDER=mock
# AI_API_KEY=
# AI_BASE_URL=
# AI_EMBEDDING_MODEL=mock-embed-small
# AI_CHAT_MODEL=

# Background jobs (Phases 3+)
# REDIS_URL=redis://localhost:6379/0

# Object storage (Phases 2+)
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# WhatsApp (Phase 10)
# WHATSAPP_PROVIDER=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=