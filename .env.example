# Copy this file to .env and fill in real values.
# Never commit .env.

# Core Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Uncomment to use PostgreSQL (requires a running server).
# In Phase 0-3 local development defaults to SQLite; no DATABASE_URL needed.
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/school_library

# --- AI provider configuration (Phase 4+). ---
# Embeddings (AI_PROVIDER):
#   mock                -> offline deterministic vectors (tests/dev)
#   openai_compatible   -> NVIDIA NIM / routers / vLLM; set AI_BASE_URL
#                          e.g. https://integrate.api.nvidia.com/v1
#   gemini              -> Google Generative Language API
# Note: Groq has NO embeddings endpoint.
# AI_PROVIDER=mock
# AI_API_KEY=
# AI_BASE_URL=
# AI_EMBEDDING_MODEL=mock-embed-small

# Chat generation (Phase 5 AI Librarian). Default: groq.
# Backups: gemini, openai_compatible (NIM), mock (offline tests).
# Per-provider default models apply unless AI_CHAT_MODEL is set.
# AI_CHAT_PROVIDER=groq
# AI_CHAT_MODEL=
# Examples:
#   groq  -> llama-3.3-70b-versatile (default)
#   gemini -> gemini-2.0-flash (default)

# Background jobs (Phases 3+)
# REDIS_URL=redis://localhost:6379/0

# Object storage (Phases 2+)
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# WhatsApp (Phase 10)
# WHATSAPP_PROVIDER=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=